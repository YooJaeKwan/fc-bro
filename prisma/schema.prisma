generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  provider      String
  providerId    String

  // 추가 회원 정보
  kakaoId       String?   @unique
  nickname      String?
  realName      String?
  phoneNumber   String?
  region        String?
  city          String?
  birthYear     String
  preferredFoot String?
  jerseyNumber  Int?      // 등번호
  mainPosition     String?
  preferredPosition String?
  subPositions     String[]
  role             String    @default("member") // member, admin

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  teams         TeamMember[]
  createdTeams  Team[]
  posts           Post[]
  comments        Comment[]
  notifications   Notification[]
  createdSchedules Schedule[]     @relation("ScheduleCreator")
  scheduleAttendances ScheduleAttendance[]
  playerStats      SchedulePlayerStat[]

  @@unique([provider, providerId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  description String?
  logo        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creatorId   String
  creator     User         @relation(fields: [creatorId], references: [id])

  members     TeamMember[]
  posts       Post[]
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      String   @default("MEMBER") // ADMIN, MEMBER
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  team      Team     @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}


model Post {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        String    // NOTICE, DISCUSSION, PHOTO
  authorId    String
  teamId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author      User      @relation(fields: [authorId], references: [id])
  team        Team      @relation(fields: [teamId], references: [id])
  comments    Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      Post     @relation(fields: [postId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // MATCH_REMINDER, TEAM_INVITE, POST_COMMENT
  title     String
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Schedule {
  id              String    @id @default(cuid())
  title           String    // 자동 생성되는 제목
  type            String    // internal, match, training
  matchDate       DateTime
  startTime       String    // "19:00"
  gatherTime      String    // "18:30"
  location        String
  quarterTime     Int       @default(20)
  restTime        Int       @default(10)
  description     String?
  opponentTeam    String?   // A매치용 상대팀명
  trainingContent String?   // 연습용 연습내용
  status          String    @default("SCHEDULED") // SCHEDULED, ONGOING, COMPLETED, CANCELLED
  
  // 경기 결과 관련 필드 (Match 테이블 기능 통합)
  ourScore        Int?      // 우리팀 점수
  opponentScore   Int?      // 상대팀 점수
  mvpUserId       String?   // MVP 선정
  matchSummary    String?   // 경기 요약/후기
  
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  creator      User      @relation("ScheduleCreator", fields: [createdBy], references: [id])
  attendances  ScheduleAttendance[]
  playerStats  SchedulePlayerStat[]  // 개별 선수 통계
}

model ScheduleAttendance {
  id         String   @id @default(cuid())
  scheduleId String
  userId     String
  status     String   @default("PENDING") // PENDING, ATTENDING, NOT_ATTENDING
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId])
}

model SchedulePlayerStat {
  id         String   @id @default(cuid())
  scheduleId String
  userId     String
  position   String?  // 해당 경기에서의 포지션
  goals      Int      @default(0)
  assists    Int      @default(0)
  yellowCard Boolean  @default(false)
  redCard    Boolean  @default(false)
  rating     Float?   // 개별 평점 (1.0-10.0)
  comment    String?  // 개별 코멘트
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule   Schedule @relation(fields: [scheduleId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId])
}